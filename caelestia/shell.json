{
    "appearance": {
        "font": {
            "family": {
                "material": "Material Symbols Rounded",
                "mono": "CaskaydiaCove NF",
                "sans": "Rubik"
            }
        },
        "rounding": {
            "scale": 1
        },
        "transparency": {
            "base": 0.85,
            "enabled": true,
            "layers": 0.4
        }
    },
    "background": {
        "desktopClock": {
            "enabled": false
        },
        "enabled": false
    },
    "bar": {
        "clock": {
            "showDate": true,
            "showIcon": true
        },
        "entries": [
            {
                "enabled": true,
                "id": "logo"
            },
            {
                "enabled": true,
                "id": "workspaces"
            },
            {
                "enabled": true,
                "id": "activeWindow"
            },
            {
                "enabled": true,
                "id": "spacer"
            },
            {
                "enabled": true,
                "id": "tray"
            },
            {
                "enabled": true,
                "id": "netSpeed"
            },
            {
                "enabled": true,
                "id": "statusIcons"
            },
            {
                "enabled": true,
                "id": "clock"
            },
            {
                "enabled": true,
                "id": "power"
            }
        ],
        "persistent": true,
        "showOnHover": true,
        "status": {
            "showBattery": true,
            "showBluetooth": true,
            "showLockStatus": true,
            "showNetwork": true,
            "showWifi": true
        },
        "workspaces": {
            "showWindows": true,
            "shown": 5
        }
    },
    "dashboard": {
        "enabled": false,
        "showMedia": true,
        "showOnHover": true,
        "showPerformance": true,
        "showWeather": true
    },
    "launcher": {
        "useFuzzy": {
            "wallpapers": false
        },
        "vimKeybinds": false
    },
    "notifs": {
        "defaultExpireTimeout": 5000,
        "expire": true
    },
    "osd": {
        "enableBrightness": true,
        "enabled": true
    },
    "paths": {
        "lyricsDir": "~/Music/lyrics",
        "wallpaperDir": "/home/rayin/Pictures/Wallpapers/work-wallpapers"
    },
    "services": {
        "showLyrics": true,
        "smartScheme": true,
        "useFahrenheit": false,
        "useTwelveHourClock": false,
        "weatherLocation": ""
