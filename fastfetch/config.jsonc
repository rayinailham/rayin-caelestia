{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "~/Pictures/terminal_art.png",
    "width": 30,
    "height": 12,
    "preserveAspectRatio": true,
    "recache": true,
    "color": {
      "1": "91"
    },
    "padding": {
      "top": 1,
      "right": 16
    }
  },
  "display": {
    "separator": "  ",
    "brightColor": true,
    "color": {
      "keys": "35",
      "title": "91",
      "separator": "90"
    }
  },
  "modules": [
    "title",
    "separator",
    "host",
    "shell",
    "wm",
    "packages",
    "cpu",
    "gpu",
    "display",
    "memory",
    "swap",
    "disk",
    "battery",
    "kernel",
    "terminal",
    "uptime",
    "colors"
  ]
}
